---
import Photo from './Photo.astro';
---
<section class="section--navy quote" aria-labelledby="quote-label">
  <div class="wrap">
    <div class="grid-12">
      <Photo class="quote__media" ratio="45" person alt="Platzhalter Porträt Werner Häuserhofer in der Werkstatt, Flanellhemd und Fleeceweste, KI-generiert" />
      <div class="quote__body">
        <p class="label label--on-navy" id="quote-label">Der Gründer</p>
        <blockquote>„Wir machen das seit 1987. Und wir machen es ordentlich.“</blockquote>
        <div class="quote__who">
          <Photo class="quote__avatar" ratio="11" person badge="KI" alt="Platzhalter Porträt Werner Häuserhofer, KI-generiert" hint="" />
          <p><b>Werner Häuserhofer</b><small>Gründer und Geschäftsführer. 2029 übergibt er an seine Tochter Julia.</small></p>
        </div>
      </div>
    </div>
  </div>
</section>
