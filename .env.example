# Demo-Umgebung Häuserhofer (Demo-Firma, fiktive Daten)
# Kopieren: cp .env.example .env
# Die Werte sind TEST-Werte für eine lokale Demo. Nur an 127.0.0.1 gebunden.
# Vor dem ersten Start die Schlüssel ersetzen, z. B. mit: openssl rand -hex 32

DEMO_ADMIN_USER=demo
DEMO_ADMIN_EMAIL=admin@haeuserhofer.example
DEMO_ADMIN_PASSWORD=demo-haeuserhofer-2026

WEBUI_SECRET_KEY=bitte-ersetzen-openssl-rand-hex-32
PAPERLESS_SECRET_KEY=bitte-ersetzen-openssl-rand-hex-32
PAPERLESS_DB_PASSWORD=bitte-ersetzen-openssl-rand-hex-16

# Ollama läuft nativ auf macOS
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_HOST_URL=http://localhost:11434
CHAT_MODEL=gemma3:12b
EMBEDDING_MODEL=bge-m3

# Ports (nur lokal)
OPEN_WEBUI_PORT=3000
PAPERLESS_PORT=8000
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
